# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file — it is already in .gitignore.

ENVIRONMENT=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- Database (Supabase Postgres connection string, "Session pooler" URI from Supabase dashboard) ---
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT].supabase.co:5432/postgres

# --- Supabase ---
SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_STORAGE_BUCKET_RESUMES=resumes
SUPABASE_STORAGE_BUCKET_RECORDINGS=interview-recordings

# --- Clerk ---
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
CLERK_JWKS_URL=https://[YOUR-CLERK-DOMAIN]/.well-known/jwks.json
CLERK_ISSUER=https://[YOUR-CLERK-DOMAIN]

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=2048
CLAUDE_MAX_RETRIES=3

# --- Vapi ---
VAPI_API_KEY=your-vapi-private-key
VAPI_WEBHOOK_SECRET=your-vapi-webhook-shared-secret
VAPI_ASSISTANT_ID=your-default-assistant-id

# --- Resend ---
RESEND_API_KEY=re_xxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- Rate limits ---
RATE_LIMIT_RESUME_UPLOAD=10/minute
RATE_LIMIT_DEFAULT=60/minute
